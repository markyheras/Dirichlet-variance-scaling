type: software
title: "Variance Scaling of the Error Term in the Dirichlet Divisor and Gauss Circle Problems: High-Precision Numerical Evidence from x in [10^3, 10^16]"
version: "2.0.0"
date-released: "2025-12-01"
doi: "10.5281/zenodo.20109870"
url: "https://doi.org/10.5281/zenodo.20109870"
license: MIT
authors:
  - family-names: "Perez"
    given-names: "Kenneth P."
    affiliation: "Independent Researcher"
